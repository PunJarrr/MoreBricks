  "authors": [
    "PunJarrr"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/morebricks",
    "issues": "https://github.com/PunJarrr/MoreBricks/issues",
    "sources": "https://github.com/PunJarrr/MoreBricks"
  },
  "license": "MIT",
  "icon": "assets/morebricks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.punjarrr.morebricks.fabric.MoreBricksFabric"
    ],
    "fabric-datagen": [
      "net.punjarrr.morebricks.fabric.datagen.MoreBricksDataGenerator"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-api": "*"
